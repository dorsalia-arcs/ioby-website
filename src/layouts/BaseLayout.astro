---
// Shared layout for the text pages (legal pages, 404). It uses the top page's stylesheets so the
// header, footer and colours match the designer's site (src/ioby-top/index.html).
// The header and footer markup mirrors that file: change both together.
import { company, contact, paths } from '../data/site';

interface Props {
  title?: string;
  description: string;
  lang?: string;
  /** Small uppercase label shown in the title band. */
  eyebrow?: string;
}

const { title, description, lang = 'ja', eyebrow } = Astro.props;
const fullTitle = title ? `${title} | iObY` : 'iObY';
const top = (page: string) => `${paths.home}#${page}`;
const pages = ['top', 'news', 'business', 'products', 'company', 'contact'];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="stylesheet" href="/assets/css/styles.css" />
    <link rel="stylesheet" href="/assets/css/ioby.css" />
  </head>
  <body class="candidate-site" data-top="a2">
    <div class="stage" data-design="a1">
      <header class="site-header">
        <a class="brand" href={paths.home} aria-label="TOPに戻る"><img class="brand-mark" src="/assets/images/logo.webp" alt="ブランドロゴ" /></a>
        <nav class="site-nav" aria-label="サイト内のページ">
          {pages.map((page) => <a href={top(page)}>{page.toUpperCase()}</a>)}
        </nav>
        <a class="header-cta" href={top('contact')}><svg class="icon" aria-hidden="true"><use href="#i-chat" /></svg>ご相談はこちら<span aria-hidden="true">›</span></a>
      </header>

      <main class="doc-page">
        {eyebrow && <div class="panel-title doc-title"><span class="en">{eyebrow}</span></div>}
        <div class="page-wrap">
          <article class="prose">
            <slot />
          </article>
        </div>
      </main>

      <footer class="site-footer">
        <div class="footer-note">
          小さな「面倒」を、大きな「効率」に。<br />資料作成 / データ整理 / 業務効率化
          <p class="footer-base">iObYは<a href={company.url}>{company.nameJa}</a>の一部門です。<br />&copy; {company.nameEn}</p>
        </div>
        <div class="footer-links">
          <nav aria-label="フッターナビゲーション">
            {pages.map((page) => <a href={top(page)}>{page.toUpperCase()}</a>)}
          </nav>
          <nav class="footer-legal" aria-label="製品・各種表記">
            <a href={paths.iobyclock}>iObY Clock</a>
            <a href={paths.tokushoho}>特定商取引法に基づく表記</a>
            <a href={paths.privacy}>プライバシーポリシー</a>
            <a href={paths.iobyclockPrivacy}>プライバシーポリシー（iObY Clock）</a>
            <a href={`mailto:${contact.supportEmail}`}>お問い合わせ</a>
          </nav>
        </div>
      </footer>
    </div>

    <svg width="0" height="0" style="position:absolute;pointer-events:none" aria-hidden="true">
      <defs>
        <symbol id="i-chat" viewBox="0 0 24 24"><path d="M20 10.7c0 4.4-3.7 7.7-8.2 7.7H8l-4 3 .6-5.1A7.1 7.1 0 0 1 3 10.7C3 6.4 6.8 3 11.5 3S20 6.4 20 10.7Z" fill="currentColor" stroke="none" /><path d="M7 11h.1M11.5 11h.1M16 11h.1" stroke="#1689d4" stroke-width="2" /></symbol>
      </defs>
    </svg>
  </body>
</html>
