---
import Skyline from '../components/Skyline.astro';
import { company, contact, paths } from '../data/site';

interface Props {
  title?: string;
  description: string;
  lang?: string;
  /** 'doc': sky band + text card (legal pages, 404). 'bare': the page draws everything below the header. */
  variant?: 'doc' | 'bare';
  /** Small uppercase label shown in the sky band of 'doc' pages. */
  eyebrow?: string;
}

const { title, description, lang = 'ja', variant = 'doc', eyebrow } = Astro.props;
const fullTitle = title ? `${title} | iObY` : 'iObY';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#08070f" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <slot name="head" />
    <style is:global>
      /* Design language follows the iObY Clock LP from the designer (_design/iobyclock-lp). Dark only. */
      :root {
        color-scheme: dark;

        --void: #08070f;
        --ink: #111117;
        --panel: #16152a;
        --panel2: #1e1c36;
        --line: rgba(255, 255, 255, .14);
        --line2: rgba(255, 255, 255, .28);

        --fg: #ffffff;
        --dim: #ccccd6;
        --faint: #8a8aa0;

        --lav: #ccc2f5;
        --lav-lt: #e5ddff;
        --peri: #adb5ff;
        --pink: #ffb2c6;
        --pink-lt: #fed6e3;
        --amber: #ffad36;
        --cream: #fff9cb;
        --teal: #b8f0ea;
        --plum: #693c56;
        --onpink: #0c0d1b;

        --gothic: "Hiragino Kaku Gothic ProN", "Yu Gothic UI", "Yu Gothic", YuGothic, Meiryo, sans-serif;

        --fs-cover: clamp(2.6rem, 1.2rem + 6.2vw, 6rem);
        --fs-scene: clamp(1.9rem, 1.1rem + 3.3vw, 3.6rem);
        --fs-h3: clamp(1.0625rem, 1rem + .35vw, 1.3rem);
        --fs-base: .9375rem;
        --fs-sm: .8125rem;
        --fs-xs: .75rem;
        --track: .15em;

        --wrap: 1200px;
        --gut: clamp(1.25rem, 4vw, 3rem);
        --sec-pad: clamp(5rem, 9vw, 9rem);

        --ease: cubic-bezier(.2, .7, .3, 1);
      }

      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body {
        margin: 0;
        background: var(--ink);
        color: var(--fg);
        font-family: var(--gothic);
        font-size: var(--fs-base);
        line-height: 1.95;
        font-feature-settings: "palt" 1;
        overflow-x: hidden;
        min-height: 100svh; display: flex; flex-direction: column;
      }
      body > main { flex: 1 0 auto; }
      img, svg { display: block; max-width: 100%; }
      a { color: inherit; text-decoration: none; }
      button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
      h1, h2, h3, p, ul, figure { margin: 0; }
      ul { padding: 0; list-style: none; }
      :focus-visible { outline: 2px solid var(--pink); outline-offset: 3px; }

      .wrap { width: 100%; max-width: var(--wrap); margin: 0 auto; padding-inline: var(--gut); }
      /* The header is fixed; keep in-page anchors below it */
      section[id], footer[id] { scroll-margin-top: 76px; }

      .grain {
        position: fixed; inset: 0; z-index: 300; pointer-events: none; opacity: .16; mix-blend-mode: overlay;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='160' height='160' filter='url(%23n)'/></svg>");
      }
      .sprites { position: absolute; width: 0; height: 0; overflow: hidden; }

      /* Sunset sky: layered gradient + low sun + faint scanlines */
      .sky { position: absolute; inset: 0; overflow: hidden; }
      .sky::before {
        content: ""; position: absolute; inset: 0;
        background:
          radial-gradient(120% 62% at 50% 96%, var(--sun, #ff9d5c) 0%, transparent 62%),
          linear-gradient(180deg,
            var(--sky1, #120e2a) 0%,
            var(--sky2, #3a2358) 34%,
            var(--sky3, #8c4a7a) 62%,
            var(--sky4, #e0748a) 82%,
            var(--sky5, #ffb47a) 100%);
      }
      .sky::after {
        content: ""; position: absolute; inset: 0; opacity: .22;
        background: repeating-linear-gradient(180deg, rgba(255, 255, 255, .055) 0 1px, transparent 1px 4px);
      }
      .skyline {
        position: absolute; left: 0; right: 0; bottom: 0; height: clamp(90px, 15vw, 190px);
        color: var(--void); pointer-events: none;
      }
      .skyline svg { width: 100%; height: 100%; display: block; }

      .eyebrow {
        font-size: var(--fs-xs); font-weight: 500; letter-spacing: .35em;
        color: var(--lav); text-transform: uppercase; line-height: 1.4;
      }
      /* Titles stay on one line. --em = width of that exact text in em (glyphs + tracking + indent)
         plus a margin; re-measure it whenever the wording changes. Keep nowrap inside @supports,
         otherwise browsers without cqw keep nowrap but lose the size cap and the text gets cut. */
      @supports (width: 1cqw) {
        .eyebrow { white-space: nowrap; font-size: min(var(--fs-xs), calc(100cqw / var(--em, 16))); }
      }
      .display {
        font-size: var(--fs-scene); font-weight: 500;
        letter-spacing: var(--track); line-height: 1.28;
        text-indent: var(--track);
      }
      @supports (width: 1cqw) {
        .display { white-space: nowrap; font-size: min(var(--fs-scene), calc(100cqw / var(--em, 21))); }
      }
      .flat__head, .scene__head, .band__in { container-type: inline-size; }
      .lead { color: var(--dim); }

      .pill {
        display: inline-flex; align-items: center; gap: .6rem;
        padding: .85rem 2rem; border-radius: 999px;
        background: var(--pink); color: var(--onpink);
        font-weight: 500; font-size: 1rem; line-height: 1.4;
        border: 1px solid var(--pink);
        transition: background .2s var(--ease), border-color .2s var(--ease);
      }
      a.pill:hover, button.pill:hover { background: var(--pink-lt); border-color: var(--pink-lt); }
      .pill--sm { padding: .5rem 1.2rem; font-size: var(--fs-sm); }
      .pill--lg { padding: 1.05rem 2.6rem; font-size: 1.0625rem; }
      .pill--ghost { background: transparent; color: var(--peri); border-color: var(--line2); }
      a.pill--ghost:hover, button.pill--ghost:hover { background: rgba(173, 181, 255, .12); border-color: var(--peri); }
      /* Not available yet: same shape, no fill, not clickable */
      .pill--soon {
        background: rgba(8, 7, 15, .35); color: var(--pink); border-color: rgba(255, 178, 198, .55);
        border-style: dashed; cursor: default;
      }

      .slab {
        background: rgba(8, 7, 15, .52); backdrop-filter: blur(3px);
        border: 1px solid var(--line); border-radius: 6px;
        padding: clamp(1.25rem, 2.6vw, 2rem);
      }

      /* Flat sections alternate --ink and --void */
      .flat { background: var(--ink); position: relative; padding-block: var(--sec-pad); }
      .flat--dark { background: var(--void); }
      .flat__head { text-align: center; max-width: 53rem; margin: 0 auto clamp(2.5rem, 5vw, 4rem); }
      .flat__head .display { margin-top: 1.1rem; }
      .flat__head .lead { margin-top: 1.5rem; }

      /* ---- Header ---- */
      .mast {
        position: fixed; top: 0; left: 0; right: 0; z-index: 120;
        display: flex; align-items: center; gap: clamp(.7rem, 1.6vw, 1.2rem);
        padding: .75rem clamp(1rem, 3vw, 2.2rem);
        background: rgba(8, 7, 15, .72); backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(255, 255, 255, .08);
        transition: background .35s var(--ease);
      }
      .mast.is-stuck { background: rgba(8, 7, 15, .92); }
      .mono {
        font-size: 1.5rem; font-weight: 700; letter-spacing: .06em; line-height: 1;
        font-style: italic; color: #fff;
      }
      .mono__logo { display: block; height: 36px; width: auto; }
      .mast__nav { display: flex; gap: 1.1rem; font-size: var(--fs-sm); letter-spacing: .1em; }
      .mast__nav a { color: rgba(255, 255, 255, .8); transition: color .2s var(--ease); }
      .mast__nav a:hover, .mast__nav a[aria-current="page"] { color: var(--pink); }
      .mast__sp { margin-left: auto; }
      @media (max-width: 420px) {
        .mast .pill--sm { padding: .5rem .9rem; font-size: var(--fs-xs); }
      }

      /* ---- Sky band for text pages ---- */
      .band { position: relative; min-height: clamp(220px, 34vw, 340px); overflow: hidden; }
      .band .skyline { height: clamp(70px, 11vw, 140px); }
      .band__in { position: relative; z-index: 2; padding-top: clamp(6.5rem, 12vw, 9rem); text-align: center; }
      .band__in .eyebrow { color: #fff; text-shadow: 0 1px 12px rgba(8, 7, 15, .7); }

      .doc { position: relative; z-index: 3; margin-top: clamp(-5rem, -6vw, -3rem); padding-bottom: var(--sec-pad); }
      .doc__card { max-width: 48rem; margin: 0 auto; background: rgba(17, 17, 23, .94); }

      /* ---- Long-form text (legal pages, 404) ---- */
      .prose { color: var(--dim); line-height: 1.95; }
      .prose h1 {
        font-size: clamp(1.4rem, 1.15rem + 1.1vw, 1.9rem); font-weight: 500; line-height: 1.45;
        letter-spacing: .06em; color: var(--fg); margin-bottom: 1.4rem;
      }
      .prose h2 {
        margin-top: 2.6rem; padding-top: 1.1rem; border-top: 1px solid var(--line);
        font-size: var(--fs-h3); font-weight: 700; letter-spacing: .04em; line-height: 1.6; color: var(--fg);
      }
      .prose h3 { margin-top: 1.8rem; font-size: 1rem; font-weight: 700; color: var(--fg); }
      .prose p, .prose ul, .prose ol, .prose table { margin-top: 1.1rem; }
      .prose ul { padding-left: 1.3em; list-style: disc; }
      .prose li::marker { color: var(--pink); }
      .prose a { color: var(--pink); text-decoration: underline; text-underline-offset: .2em; text-decoration-thickness: 1px; }
      .prose a:hover { color: var(--pink-lt); }
      .prose hr { margin: 3.5rem 0; border: 0; border-top: 1px solid var(--line2); }
      .prose section > :first-child { margin-top: 0; }
      .prose table { border-collapse: collapse; width: 100%; font-size: var(--fs-base); }
      .prose th, .prose td { border-bottom: 1px solid var(--line); padding: .9rem .75rem; text-align: left; vertical-align: top; }
      .prose th { width: 30%; font-weight: 700; color: var(--fg); }
      .prose tr:first-child th, .prose tr:first-child td { border-top: 1px solid var(--line2); }
      .muted { color: var(--faint); }
      @media (max-width: 30rem) {
        .prose th, .prose td { display: block; width: 100%; }
        .prose th { padding-bottom: .1rem; border-bottom: 0; font-size: var(--fs-sm); color: var(--lav); letter-spacing: .08em; }
        .prose td { padding-top: .2rem; }
        .prose tr:first-child td { border-top: 0; }
      }

      /* ---- Footer ---- */
      .foot { background: var(--void); padding-block: clamp(2.5rem, 4.5vw, 3.5rem); border-top: 1px solid rgba(255, 255, 255, .06); }
      .foot__in { display: grid; gap: 1.4rem; justify-items: center; text-align: center; }
      .foot__links { display: flex; flex-wrap: wrap; justify-content: center; gap: .4rem 1.6rem; font-size: var(--fs-sm); letter-spacing: .06em; }
      .foot__links a { color: var(--dim); transition: color .2s var(--ease); }
      .foot__links a:hover { color: var(--pink); }
      .foot__note { font-size: var(--fs-xs); color: var(--faint); line-height: 1.9; }
      .foot__note a { text-decoration: underline; text-underline-offset: .2em; }
      .foot__base { font-size: var(--fs-xs); color: var(--faint); line-height: 1.9; letter-spacing: .06em; }
      .foot__base a:hover { color: var(--pink); }
    </style>
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>

    <svg class="sprites" aria-hidden="true">
      <defs>
        <g id="palm">
          <path d="M-4 0 C-2 -26 0 -45 5 -59 L12 -57 C6 -43 4 -25 4 0 Z" />
          <path d="M8 -61 C-6 -77 -27 -83 -44 -79 C-25 -87 -5 -81 9 -67 Z" />
          <path d="M8 -61 C-2 -81 -19 -95 -35 -99 C-17 -99 0 -85 10 -67 Z" />
          <path d="M8 -61 C8 -81 4 -97 -6 -110 C8 -99 15 -81 12 -65 Z" />
          <path d="M9 -61 C23 -79 41 -89 58 -89 C39 -85 23 -73 12 -63 Z" />
          <path d="M9 -61 C25 -75 45 -81 62 -77 C43 -79 25 -71 12 -61 Z" />
          <path d="M9 -62 C21 -85 35 -99 50 -105 C35 -95 21 -81 12 -65 Z" />
        </g>
        <path id="cityline" d="M0 190 V152 H62 V122 H104 V152 H152 V96 H192 V152 H244 V132 H302 V162 H362 V112 H404 V162 H462 V142 H522 V172 H582 V126 H624 V172 H702 V152 H762 V106 H802 V152 H862 V166 H922 V136 H972 V166 H1042 V146 H1102 V116 H1142 V146 H1202 V162 H1262 V132 H1322 V162 H1382 V152 H1440 V190 Z" />
        <g id="skyline-full">
          <use href="#cityline" />
          <use href="#palm" transform="translate(150 190) scale(1.05)" />
          <use href="#palm" transform="translate(1290 190) scale(-1.15 1.15)" />
          <use href="#palm" transform="translate(520 190) scale(.78)" />
          <use href="#palm" transform="translate(1010 190) scale(-.7 .7)" />
        </g>
      </defs>
    </svg>

    <header class="mast" id="mast">
      <a class="mono" href={paths.home}><img class="mono__logo" src="/ioby-logo.svg" alt="iObY" width="40" height="44" /></a>
      <nav class="mast__nav" aria-label="製品">
        <a href={paths.iobyclock} aria-current={Astro.url.pathname === paths.iobyclock ? 'page' : undefined}>iObY Clock</a>
      </nav>
      <span class="mast__sp"></span>
      <slot name="mast" />
    </header>

    {variant === 'doc' ? (
      <>
        <div class="band">
          <div class="sky" aria-hidden="true"></div>
          <Skyline />
          {eyebrow && <div class="wrap band__in"><p class="eyebrow" style={`--em:${(eyebrow.length * 1.05 + 1).toFixed(2)}`}>{eyebrow}</p></div>}
        </div>
        <main class="doc">
          <div class="wrap">
            <article class="slab doc__card prose">
              <slot />
            </article>
          </div>
        </main>
      </>
    ) : (
      <main>
        <slot />
      </main>
    )}

    <footer class="foot">
      <div class="wrap foot__in">
        <a class="mono" href={paths.home}>iObY</a>
        <ul class="foot__links">
          <li><a href={paths.iobyclock}>iObY Clock</a></li>
          <li><a href={paths.tokushoho}>特定商取引法に基づく表記</a></li>
          <li><a href={paths.iobyclockPrivacy}>プライバシーポリシー（iObY Clock）</a></li>
          <li><a href={`mailto:${contact.supportEmail}`}>お問い合わせ</a></li>
        </ul>
        <slot name="footer-note" />
        <p class="foot__base">
          iObY は <a href={company.url}>{company.nameJa}</a> の一部門です。<br />
          &copy; {company.nameEn}
        </p>
      </div>
    </footer>

    <script>
      const mast = document.getElementById('mast');
      if (mast) {
        const onScroll = () => mast.classList.toggle('is-stuck', window.scrollY > 40);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
  </body>
</html>
