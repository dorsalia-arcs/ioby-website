---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { company, contact } from '../../data/site';

const rows: [string, string][] = [
  ['販売業者', company.nameJa],
  ['運営統括責任者', company.representative],
  ['所在地', company.address],
  ['電話番号', contact.phone],
  ['メールアドレス', contact.supportEmail],
  ['販売価格', '各商品の販売ページ（Microsoft Store 等）に表示しています。'],
  ['商品代金以外の必要料金', 'インターネット接続料金・通信料金はお客様のご負担となります。'],
  ['支払方法', '各ストアの定める方法によります。'],
  ['支払時期', '各ストアの定める時期によります。'],
  ['引渡時期', '購入手続き完了後、すぐにダウンロードいただけます。'],
  ['返品・キャンセル', 'デジタル商品の性質上、購入後の返品はお受けしていません。返金は Microsoft Store 等の各ストアの返金手続き・規定に従います。'],
  ['動作環境', '各商品の販売ページに記載しています。'],
];
---
<BaseLayout eyebrow="Legal Notice" title="特定商取引法に基づく表記" description="iObY（合同会社Dorsalia Arcs）が販売する TK シリーズの特定商取引法に基づく表記です。">
  <h1>特定商取引法に基づく表記</h1>
  <p>TK シリーズ各商品に共通の表記です。</p>
  <table>
    <tbody>
      {rows.map(([label, value]) => (
        <tr>
          <th scope="row">{label}</th>
          <td>
            {label === 'メールアドレス' ? <a href={`mailto:${value}`}>{value}</a> : value}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</BaseLayout>
