---
import BaseLayout from '../layouts/BaseLayout.astro';
import Skyline from '../components/Skyline.astro';
import { brand, company, contact, paths } from '../data/site';
---
<BaseLayout
  description="iObY は資料作成、AI活用のサポート、業務ツール「TKシリーズ」の開発を行う、合同会社Dorsalia Arcs の一部門です。"
  variant="bare"
>
  <section class="hero">
    <div class="sky" aria-hidden="true"></div>
    <Skyline />
    <div class="wrap hero__in">
      <p class="eyebrow hero__eyebrow">A Division of {company.nameEn}</p>
      <h1 class="hero__word">iObY</h1>
      <p class="hero__tag">{brand.summary}</p>
      <div class="hero__ctas">
        <a class="pill pill--lg" href={paths.iobyclock}>iObY Clock を見る</a>
        <a class="hero__sub" href={`mailto:${contact.supportEmail}`}>お問い合わせ</a>
      </div>
    </div>
  </section>

  <section class="flat flat--dark" id="work">
    <div class="wrap">
      <div class="flat__head">
        <p class="eyebrow" style="--em:10">What We Do</p>
        <h2 class="display" style="--em:7.5">iObY の仕事</h2>
      </div>
      <ul class="cards">
        {brand.points.map((point, i) => (
          <li class="card">
            <span class="card__no">{String(i + 1).padStart(2, '0')}</span>
            <b>{point}</b>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="flat" id="products">
    <div class="wrap">
      <div class="flat__head">
        <p class="eyebrow" style="--em:9">Products</p>
        <h2 class="display" style="--em:7.5">TK シリーズ</h2>
      </div>
      <a class="product" href={paths.iobyclock}>
        <span class="product__img" aria-hidden="true"></span>
        <span class="product__body">
          <span class="product__name">iObY Clock</span>
          <span class="product__desc">テーマや書体を選んで楽しめる、Windows 用のデスクトップ時計。Microsoft Store で公開準備中です。</span>
          <span class="product__more">くわしく見る →</span>
        </span>
      </a>
    </div>
  </section>

  <section class="flat flat--dark" id="about">
    <div class="wrap about">
      <p>iObY は <a href={company.url}>{company.nameJa}</a> の一部門です。</p>
      <h2 class="about__h">各種表記</h2>
      <ul class="about__links">
        <li><a href={paths.tokushoho}>特定商取引法に基づく表記</a></li>
        <li><a href={paths.iobyclockPrivacy}>プライバシーポリシー（iObY Clock）</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative; min-height: 100svh; overflow: hidden;
    display: flex; align-items: center;
    padding-block: 6rem clamp(8rem, 18vw, 13rem);
  }
  .hero__in { position: relative; z-index: 2; text-align: center; container-type: inline-size; }
  .hero__eyebrow { color: rgba(255, 255, 255, .85); text-shadow: 0 1px 14px rgba(8, 7, 15, .7); --em: 33; }
  .hero__word {
    margin-top: 1.1rem;
    font-size: min(clamp(3.4rem, 1.6rem + 8vw, 7.5rem), 16vh);
    font-weight: 300; font-style: italic; letter-spacing: .08em; line-height: 1.05;
    text-shadow: 0 4px 34px rgba(8, 7, 15, .5);
  }
  .hero__tag {
    max-width: 36rem; margin: 1.6rem auto 0;
    font-size: clamp(.9375rem, .85rem + .45vw, 1.15rem); line-height: 2;
    text-shadow: 0 2px 16px rgba(8, 7, 15, .75);
  }
  .hero__ctas {
    margin-top: 2.4rem;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .9rem 1.4rem;
  }
  .hero__sub {
    padding-bottom: .15rem; font-size: var(--fs-sm); letter-spacing: .12em; color: rgba(255, 255, 255, .85);
    border-bottom: 1px solid rgba(255, 255, 255, .35); text-shadow: 0 1px 12px rgba(8, 7, 15, .8);
    transition: color .2s var(--ease), border-color .2s var(--ease);
  }
  .hero__sub:hover { color: var(--pink); border-color: var(--pink); }

  .cards { display: grid; gap: 1rem; grid-template-columns: 1fr; max-width: 60rem; margin: 0 auto; }
  @media (min-width: 760px) { .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .card {
    padding: clamp(1.4rem, 2.6vw, 2rem); border: 1px solid var(--line); border-radius: 6px;
    background: linear-gradient(160deg, var(--panel2), var(--panel));
  }
  .card__no { display: block; font-size: var(--fs-xs); letter-spacing: .3em; color: var(--pink); }
  .card b { display: block; margin-top: .6rem; font-size: 1.0625rem; line-height: 1.7; }

  .product {
    display: grid; grid-template-columns: 1fr; max-width: 60rem; margin: 0 auto; overflow: hidden;
    border: 1px solid var(--line2); border-radius: 6px; background: var(--panel);
    transition: border-color .2s var(--ease);
  }
  .product:hover { border-color: var(--pink); }
  @media (min-width: 760px) { .product { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); } }
  .product__img {
    min-height: 220px; aspect-ratio: 16 / 10;
    background: url(/iobyclock/media/ph-sea.webp) center / cover;
  }
  .product__body { display: grid; align-content: center; gap: .7rem; padding: clamp(1.4rem, 3vw, 2.4rem); }
  .product__name { font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.2rem); font-weight: 300; letter-spacing: .08em; line-height: 1.2; }
  .product__desc { color: var(--dim); }
  .product__more { font-size: var(--fs-sm); letter-spacing: .12em; color: var(--pink); }

  .about { max-width: 48rem; text-align: center; color: var(--dim); }
  .about a { color: var(--pink); text-decoration: underline; text-underline-offset: .2em; }
  .about__h { margin-top: 2.2rem; font-size: var(--fs-sm); letter-spacing: .3em; color: var(--lav); font-weight: 500; }
  .about__links { margin-top: .8rem; display: flex; flex-wrap: wrap; justify-content: center; gap: .4rem 1.6rem; }
</style>
