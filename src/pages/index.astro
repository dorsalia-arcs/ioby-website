---
// / is the designer's site mock (design 03) in src/ioby-top/index.html, with the owner's edits. Edit that file directly.
// Its CSS, JS and images are in public/assets/ (the HTML refers to them as assets/...); our additions are in assets/css/ioby.css.
// Here only the %%NAME%% markers are resolved from site.ts.
import top from '../ioby-top/index.html?raw';
import { company, contact, paths } from '../data/site';
import { news, newsPath } from '../data/news';

// Values go into text and attributes, so escape them; a function replacer keeps "$&" etc. literal.
const esc = (s: string) =>
  s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
const markers: [string, string][] = [
  ['%%IOBYCLOCK%%', paths.iobyclock],
  ['%%NEWS_RENEWAL%%', newsPath(news[0])],
  ['%%SITE_PRIVACY%%', paths.privacy],
  ['%%PRIVACY%%', paths.iobyclockPrivacy],
  ['%%TOKUSHOHO%%', paths.tokushoho],
  ['%%SUPPORT_EMAIL%%', contact.supportEmail],
  ['%%COMPANY_URL%%', company.url],
  ['%%COMPANY_EN%%', company.nameEn],
  ['%%COMPANY%%', company.nameJa],
  ['%%ADDRESS%%', company.address],
  ['%%REPRESENTATIVE%%', company.representative],
];
for (const [, value] of markers.filter(([m]) => ['%%IOBYCLOCK%%', '%%NEWS_RENEWAL%%', '%%SITE_PRIVACY%%', '%%PRIVACY%%', '%%TOKUSHOHO%%', '%%COMPANY_URL%%'].includes(m))) {
  if (!/^(https:\/\/|\/)/.test(value)) throw new Error(`Link must start with https:// or /: ${value}`);
}
const html = markers.reduce((out, [marker, value]) => out.replaceAll(marker, () => esc(value)), top);

const left = html.match(/%%[A-Z_]+%%/);
if (left) throw new Error(`Unresolved marker in the top page: ${left[0]}`);
---
<Fragment set:html={html} />
