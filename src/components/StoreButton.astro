---
import { tkclock } from '../data/site';

interface Props {
  size?: 'sm' | 'lg';
  short?: boolean;
}

const { size, short = false } = Astro.props;
const cls = ['pill', size && `pill--${size}`].filter(Boolean).join(' ');
const url = tkclock.storeUrl;
---
{url ? (
  <a class={cls} href={url}>{short ? '入手する' : 'Microsoft Store で入手（無料）'}</a>
) : (
  <span class={`${cls} pill--soon`} aria-disabled="true">{short ? '近日公開' : 'Microsoft Store で近日公開'}</span>
)}
